# Copy to .env for local dev. On Render, paste these as Environment Variables instead. Never commit .env.
# Setup: Render backend (Docker) + Render static frontend + Aiven MySQL.

# ---- Database (Aiven MySQL — the ONLY db vars you need) ----
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-1d21586c-roleready-e9ec.l.aivencloud.com:16343/defaultdb?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=

# ---- Backend (Render Web Service) ----
# NOTE: Render injects PORT automatically — leave PORT unset on Render.
PORT=8080
FRONTEND_URL=http://localhost:4200
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200
JWT_SECRET=change-me-to-a-32-byte-minimum-secret-for-dev-only
JWT_EXPIRATION_MS=86400000

# ---- Google OAuth (FR-AUTH-004) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ---- Gemini (backend only, never expose to browser — NFR-SEC-007) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---- Mail (verification + password reset, FR-AUTH-002/005) ----
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Never use your normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=
MAIL_FROM=you@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# ---- App policy ----
APP_GUEST_MAX_USES=3
APP_SESSION_TTL_MINUTES=120
APP_MAX_FILE_SIZE=10MB

# ---- Frontend (build-time) ----
API_BASE_URL=http://localhost:8080
